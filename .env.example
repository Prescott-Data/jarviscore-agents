# Copy to .env and fill in one model provider. The Desk reads it with --env-file;
# a blueprint run from the command line reads it from the directory you run in.

# --- A model (any one provider JarvisCore supports) ---
# AZURE_API_KEY=...
# AZURE_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_DEPLOYMENT=gpt-4o
# CLAUDE_API_KEY=...
# GEMINI_API_KEY=...
# LLM_ENDPOINT=http://localhost:8000      # a local vLLM / OpenAI-compatible server
# LLM_MODEL=Qwen/Qwen2.5-32B-Instruct

# Reasoning deployments spend output tokens thinking: declare their ceiling.
# LLM_MODEL_OUTPUT_LIMITS='{"your-deployment":32000}'

# --- Redis: the Mesh's shared ledger (docker run -d -p 6379:6379 redis:7) ---
REDIS_URL=redis://localhost:6379/0

# --- Software Reliability only ---
# The agents build and test the repository they inspect. Allow it only for code you
# trust, or in a disposable container or VM.
# ALLOW_UNSAFE_LOCAL_EXECUTION=true
